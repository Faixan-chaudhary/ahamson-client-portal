DATABASE_URL=sqlite:///./ahamson.db
ENVIRONMENT=production
SECRET_KEY=CHANGE_ME_USE_32_PLUS_RANDOM_CHARACTERS
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://YOUR_SERVER_IP:8080
MAX_REQUEST_BODY_BYTES=6000000
MAX_URL_PATH_LENGTH=2048
MAX_QUERY_STRING_LENGTH=4096
REQUEST_TIMEOUT_SECONDS=30
GLOBAL_RATE_LIMIT_REQUESTS=300
GLOBAL_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_REQUESTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=300
ADMIN_RATE_LIMIT_REQUESTS=180
ADMIN_RATE_LIMIT_WINDOW_SECONDS=60
CLIENT_RATE_LIMIT_REQUESTS=120
CLIENT_RATE_LIMIT_WINDOW_SECONDS=60
MAX_CONCURRENT_REQUESTS_PER_IP=25
IP_BAN_VIOLATION_THRESHOLD=15
IP_BAN_VIOLATION_WINDOW_SECONDS=300
IP_BAN_DURATION_SECONDS=900
TRUSTED_PROXIES=
ALLOWED_HOSTS=*
ADMIN_EMAIL=admin@ahamson.com
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
ADMIN_NAME=Admin
LINK_EXPIRE_HOURS=2
SUPPORT_EMAIL=documents@ahamson.com
FRONTEND_URL=http://YOUR_SERVER_IP:8080
PASSWORD_RESET_EXPIRE_MINUTES=60
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
SERVE_FRONTEND=true
FRONTEND_DIST_PATH=../dist
HOST=0.0.0.0
PORT=8080
